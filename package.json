{
  "name": "starward",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "textures:fetch": "node scripts/planet-textures.mjs",
    "textures:check": "node scripts/planet-textures.mjs --check",
    "pack": "node scripts/planet-textures.mjs --check && node scripts/pack.mjs",
    "release": "node scripts/release.mjs",
    "share": "node scripts/apk-install-qr.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.3.0",
    "@capacitor/core": "8.3.0",
    "three": "0.134.0",
    "vue": "3.5.32"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.0",
    "@types/three": "0.134.0",
    "@vitejs/plugin-vue": "5.2.4",
    "qrcode": "1.5.4",
    "typescript": "5.3.3",
    "vite": "5.4.21",
    "vue-tsc": "1.8.27"
  }
}
